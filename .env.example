# Example environment configuration — DO NOT COMMIT REAL VALUES

# ─── Frappe Site Configuration ────────────────────────────────────────────────
# These values belong in sites/<site>/site_config.json — NOT committed to Git.
# Copy this file to .env.local and fill in actual values for your environment.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_site_db_name
DB_PASSWORD=REPLACE_WITH_ACTUAL_PASSWORD

# Redis
REDIS_CACHE=redis://localhost:13000
REDIS_QUEUE=redis://localhost:11000
REDIS_SOCKETIO=redis://localhost:12000

# ─── NXERP Custom Config ─────────────────────────────────────────────────────
# Override the "Contact IT Support" link in the login page footer.
# Must start with mailto:, https://, or /
NXERP_SUPPORT_URL=https://mail.google.com/mail/?view=cm&to=support@yourdomain.com

# Restrict API access for non-system users (1 = enabled, 0 = disabled)
BLOCK_ENDPOINTS=1

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Configure via Frappe's Email Account DocType, not here.
# Never hardcode SMTP credentials in code or environment files.

# ─── GitHub Actions Secrets (for CI/CD) ──────────────────────────────────────
# These are configured in GitHub Settings → Secrets and are NEVER in files.
# Reference only:
#
#   STAGING_SSH_KEY        SSH private key for staging server
#   STAGING_HOST           Staging server hostname
#   STAGING_USER           SSH username
#   STAGING_SITE           Frappe site name on staging
#   STAGING_BENCH_PATH     Bench directory on staging
#
#   CODECOV_TOKEN          Coverage reporting token
#   SEMGREP_APP_TOKEN      Semgrep Cloud token (optional)
#
#   PROD_SSH_KEY           (when production CD is enabled)
#   PROD_HOST
#   PROD_USER
#   PROD_SITE
#   PROD_BENCH_PATH
