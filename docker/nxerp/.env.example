# Copy to .env and fill in. The real .env is untracked (see .git/info/exclude).
IMAGE=ghcr.io/sriainfotech/frappe-help-desk:nxerp-8bb287a
SITE_NAME=nxerp.localhost
DB_ROOT_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# HRMS API Configuration
HRMS_API_BASE_URL=https://hrms.example.invalid
HRMS_API_KEY=your-hrms-api-key

# PBT Project Budgeting API Configuration
# Base URL only: the integration appends /api/v1/projects/ itself.
PBT_API_BASE_URL=https://pbt.example.invalid
PBT_API_KEY=your-pbt-api-key
