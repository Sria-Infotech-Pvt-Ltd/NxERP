# Local NXERP image: the CI-built base image plus the working-tree (uncommitted) helpdesk/desk changes,
# with the frontend rebuilt inside the image. Built by build-local-image.sh; never pushed.
ARG BASE_IMAGE=ghcr.io/sriainfotech/frappe-help-desk:nxerp-8bb287a
FROM ${BASE_IMAGE}
USER frappe
# NLTK data for TextBlob (Knowledge Base article suggestions): exactly the packages
# helpdesk.search.download_corpus fetches, pinned by checksum so a changed upstream fails the build.
RUN cd /home/frappe/frappe-bench \
 && env/bin/python -m nltk.downloader -d /home/frappe/nltk_data averaged_perceptron_tagger_eng punkt_tab brown \
 && cd /home/frappe/nltk_data \
 && echo "9b275f9b3b95d7bd66ccfb7cd259f445a13bbe5d1f4107aba09fd3e8364bafa6  corpora/brown.zip" > /tmp/nltk.sha256 \
 && echo "6025f530624335c67d6547d44757b357b4e79bae030a0383e9887a92c1718f0b  taggers/averaged_perceptron_tagger_eng.zip" >> /tmp/nltk.sha256 \
 && echo "e57f64187974277726a3417ca6f181ec5403676c717672eef6a748a7b20e0106  tokenizers/punkt_tab.zip" >> /tmp/nltk.sha256 \
 && sha256sum -c /tmp/nltk.sha256 \
 && rm /tmp/nltk.sha256 \
 && cd /home/frappe/frappe-bench \
 && env/bin/python -c "from textblob import TextBlob; b = TextBlob('reset my customer password'); assert b.pos_tags and b.noun_phrases"
COPY --chown=frappe:frappe overlay/ /home/frappe/frappe-bench/apps/helpdesk/
# Vite reads socketio_port from common_site_config.json, which the image does not set (the compose
# configurator sets it at runtime), so set it for the build only and restore the file afterwards.
RUN export PATH=/home/frappe/.nvm/versions/node/v22.23.3/bin:$PATH NODE_OPTIONS=--max-old-space-size=6144 \
 && cd /home/frappe/frappe-bench \
 && cp sites/common_site_config.json /tmp/csc.json \
 && bench set-config -gp socketio_port 9000 \
 && cd apps/helpdesk/desk && npx vite build \
 && cp /tmp/csc.json /home/frappe/frappe-bench/sites/common_site_config.json
