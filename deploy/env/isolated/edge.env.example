# Template for deploy/env/isolated/edge.env (git-ignored). No secrets.
NXERP_DOMAIN=example.test
NXERP_EDGE_PORT=8080
# optional: also answer on this extra host, routed to the stack named in NXERP_LEGACY_STACK (the old single-site name during a move)
# NXERP_LEGACY_HOST=
# NXERP_LEGACY_STACK=erp
# Phase 8: the OLD single-site host name. Instead of NXERP_LEGACY_STACK, give the old site's name and the host answers like this:
# /helpdesk and /helpdesk/<path> redirect (301, path and query kept) to https://hd.<NXERP_DOMAIN>/helpdesk/<path>; everything else goes to the
# old backend (erp-backend:8000 on the nxerp-api network, see deploy/docker/compose/isolated/legacy-erp.override.yaml).
# NXERP_LEGACY_HOST=
# NXERP_LEGACY_SITE=
# NXERP_LEGACY_HD_BASE=      optional full base URL, e.g. http://hd.localhost:8080 (rehearsal); default https://hd.<NXERP_DOMAIN>
