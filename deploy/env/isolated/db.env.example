# Template for deploy/env/isolated/db.env (git-ignored). Copy it, chmod 600, then replace every CHANGE_ME with a generated value:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# Two DIFFERENT passwords. Never commit the filled-in file.

# --- required: database administrator passwords (used only by `stack.sh <stack> create-site`)
NXERP_DB_ROOT_PASSWORD_STANDARD=CHANGE_ME
NXERP_DB_ROOT_PASSWORD_RESTRICTED=CHANGE_ME

# --- optional (defaults shown): the fixed private subnets of the two tiers; stack env files use matching NXERP_DB_USER_SCOPE
# NXERP_DB_SUBNET_STANDARD=172.30.10.0/24
# NXERP_DB_SUBNET_RESTRICTED=172.30.20.0/24
# MARIADB_IMAGE=mariadb:11.8
