# GENERIC template for any further app stack (apps 3 to 5 are PLANNED: none is installed or built here). To add an app:
#   1. cp deploy/env/isolated/app.env.example deploy/env/isolated/<name>.env ; chmod 600 ; fill it in
#   2. add one line to deploy/env/isolated/stacks.list:   <name> <host-prefix> <standard|restricted>
#   3. deploy/scripts/stack.sh <name> create-site ; deploy/scripts/stack.sh <name> up ; deploy/scripts/edge-gen.sh ; deploy/scripts/stack.sh edge up
# Nothing else changes. NXERP_STACK must equal <name>. Use a fresh password.
NXERP_STACK=CHANGE_ME_name
NXERP_SITE=CHANGE_ME_name.example.test
NXERP_ADMIN_PASSWORD=CHANGE_ME
NXERP_IMAGE_TAG=CHANGE_ME_e.g._0.1.0-ab12cd34ef56
# standard tier shown; for the restricted tier use mariadb-restricted, nxerp-db-restricted and 172.30.20.%
NXERP_DB_HOST=mariadb-standard
NXERP_DB_NETWORK=nxerp-db-standard
NXERP_DB_USER_SCOPE=172.30.10.%
# the apps to install on this site, in order (the image carries the apps; a site installs only what is listed)
NXERP_STACK_APPS=nxerp
NXERP_EXPECT_APPS=frappe nxerp
# NXERP_PUBLIC_URL=https://CHANGE_ME_name.example.test
