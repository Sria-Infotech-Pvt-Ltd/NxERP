# Template for deploy/env/staging-like/.env (git-ignored). Copy it, then replace every CHANGE_ME with a generated value:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# Never commit the filled-in file.

# --- required
NXERP_IMAGE_TAG=CHANGE_ME_e.g._0.1.0-ab12cd34ef56
NXERP_SITE=staging.example.test
NXERP_DB_ROOT_PASSWORD=CHANGE_ME
NXERP_ADMIN_PASSWORD=CHANGE_ME

# --- optional (defaults shown)
# NXERP_IMAGE=ghcr.io/sria-infotech-pvt-ltd/nxerp
# NXERP_HTTP_PORT=8080
# NXERP_PUBLIC_URL=http://localhost:8080
# MARIADB_IMAGE=mariadb:11.8
# REDIS_IMAGE=redis:8.6-alpine
# NGINX_IMAGE=nginx:1.27-alpine
