# Environment for the shared read layer stack (deploy/docker/compose/shared). Copy to deploy/env/shared/shared.env (git-ignored,
# mode 600) or let `deploy/scripts/shared.sh init-env` create it with generated passwords. Every value below is an obvious fake.

# the application image that carries the nxerp package (the same image as the apps)
NXERP_IMAGE_TAG=CHANGE_ME_e.g._0.1.0-ab12cd34ef56
# NXERP_IMAGE=ghcr.io/sria-infotech-pvt-ltd/nxerp
# MARIADB_IMAGE=mariadb:11.8

SHARED_DB_NAME=nxerp_shared

# four passwords, each at least 20 random characters (init-env generates them with python's secrets module)
SHARED_DB_ROOT_PASSWORD=CHANGE_ME_root
SHARED_MIGRATE_PASSWORD=CHANGE_ME_migrate
SHARED_PROJECTOR_PASSWORD=CHANGE_ME_projector
SHARED_READAPI_PASSWORD=CHANGE_ME_readapi

# 1 = every account REQUIRE SSL and the services connect with TLS
SHARED_DB_REQUIRE_SSL=0
# optional per-app reporting accounts (read-only views of one app), comma separated app keys, each with
# SHARED_REPORT_RO_<APP>_PASSWORD (upper case); empty = none
SHARED_REPORT_RO_APPS=

# where the projector reads its sources (see sources.example.json) and the files its key_file entries name
SHARED_SOURCES_FILE=./deploy/env/shared/sources.json
SHARED_SECRETS_DIR=./deploy/env/shared/secrets
# 1 only on a throwaway test stack: allows http:// feed URLs (default off: https only)
SHARED_ALLOW_INSECURE_FEED=0

# the private network the apps and the shared services meet on (created by shared.sh if missing)
SHARED_SYNC_NETWORK=nxerp_sync

# development and tests only: run the working copy of the code (see shared.dev.override.yaml); leave empty in production
SHARED_DEV_SRC=
