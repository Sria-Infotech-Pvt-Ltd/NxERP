# The only writer of the shared read database: pulls each owner's feed and applies it. Install: see deploy/baremetal/README.md, step 5.
[Unit]
Description=NXDESK shared layer projector
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/nxerp/frappe-bench
EnvironmentFile=/etc/nxerp-shared/shared.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SHARED_PROJECTOR_USER=shared_projector
ExecStart=/srv/apps/nxerp/frappe-bench/env/bin/python -m nxerp.shared_service projector
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
