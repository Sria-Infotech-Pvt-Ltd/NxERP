# /etc/nxerp-shared/shared.env  (mode 640, owner root, group deploy). Fill every CHANGE_ME with a fresh random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Never commit the filled file. The database root password is used ONCE by setup-shared-layer.sh and is not kept here.
SHARED_DB_HOST=127.0.0.1
SHARED_DB_PORT=3306
SHARED_DB_NAME=nxerp_shared
SHARED_DB_REQUIRE_SSL=0
SHARED_SOURCES_FILE=/etc/nxerp-shared/sources.json
SHARED_MIGRATE_PASSWORD=CHANGE_ME
SHARED_PROJECTOR_PASSWORD=CHANGE_ME
SHARED_READAPI_PASSWORD=CHANGE_ME
# the owners are reached over https, so feeds stay https only
SHARED_ALLOW_INSECURE_FEED=0
