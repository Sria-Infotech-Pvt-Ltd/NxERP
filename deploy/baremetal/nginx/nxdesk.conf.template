# nginx entry for the NXDESK front door (the identity site). The easiest and safest way to install it:
#   1. sudo cp /etc/nginx/sites-available/<the file of nxerp.nxsys.in> /etc/nginx/sites-available/nxdesk.nxsys.in
#   2. in the copy, replace every `nxerp.nxsys.in` with `nxdesk.nxsys.in` (server_name and the X-Frappe-Site-Name header), delete the
#      ssl_certificate lines (certbot adds its own) and keep the proxy_pass ports exactly as in the file you copied
#   3. sudo ln -s /etc/nginx/sites-available/nxdesk.nxsys.in /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
#   4. sudo certbot --nginx -d nxdesk.nxsys.in
# The block below shows what the copy must contain (the ports are examples: use the ones in the file you copied).
server {
    listen 80;
    server_name nxdesk.nxsys.in;
    client_max_body_size 50m;

    # the app-to-app endpoints are never public
    location ~* ^/api/(v[0-9]+/)?method/nxerp\.(federation|shared)\. { return 404; }
    if ($arg_cmd ~* "^nxerp\.(federation|shared)\.") { return 404; }

    location /socket.io {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Frappe-Site-Name nxdesk.nxsys.in;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:9005;   # the nxerp bench's socketio port
    }
    location / {
        proxy_set_header X-Frappe-Site-Name nxdesk.nxsys.in;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_pass http://127.0.0.1:8005;   # the nxerp bench's gunicorn
    }
}
