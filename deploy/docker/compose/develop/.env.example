# Template for .env in this folder (git-ignored). Copy it and replace every placeholder; never commit the filled-in file.
# Passwords: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'

# Docker Configuration
# IMAGE: built from the checked-out branch by deploy/docker/build.sh (tag <version>-<12-char git sha>)
IMAGE=ghcr.io/sria-infotech-pvt-ltd/nxerp:<version>-<git-sha>
SITE_NAME=nxerp.localhost
HTTP_PORT=8012
DB_ROOT_PASSWORD=<strong-unique-password>
ADMIN_PASSWORD=<strong-unique-password>

# HRMS API Configuration (passed to the backend service only)
HRMS_API_BASE_URL=https://hrms.example.invalid
HRMS_API_KEY=<valid-HRMS-api-key>

# PBT Project Budgeting API Configuration (passed to the backend service only)
# Base URL only: the integration appends /api/v1/projects/ itself.
PBT_API_BASE_URL=https://pbt.example.invalid
PBT_API_KEY=<valid-PBT-api-key>
