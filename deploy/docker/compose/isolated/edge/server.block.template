# ONE server block for ONE stack (Phase 5C). edge-gen.sh replaces ${STACK}, ${HOST}, ${HOST_LOCAL} and ${NXERP_SITE} (and nothing else; nginx's own
# $variables stay) and appends the result to the generated edge file. Nothing here names an app: any number of stacks use this template.

server {
  listen 8080;
  server_name ${HOST} ${HOST_LOCAL};
  client_max_body_size 50m;

  set $nxerp_backend ${STACK}-backend:8000;
  set $nxerp_websocket ${STACK}-websocket:9000;

  # proxy_pass forwards the client's raw URI: refuse dot-segments (plain or percent-encoded) instead of handing a traversal attempt to the backend
  if ($request_uri ~* "(^|/|%2f|\\|%5c)(\.|%2e)(\.|%2e)(/|%2f|\\|%5c|\?|$)") {
    return 400;
  }

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # App-to-app endpoints (the outbox feed and the federation/command API) are for the sync network only: never public.
  # Matches the decoded, normalised path (so %2E tricks do not help), the v1 and v2 API styles and the legacy ?cmd= form.
  location ~* ^/api/(v[0-9]+/)?method/nxerp\.(federation|shared)\. {
    return 404;
  }
  if ($arg_cmd ~* "^nxerp\.(federation|shared)\.") {
    return 404;
  }

  location /socket.io {
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $nxerp_connection_upgrade;
    proxy_set_header X-Frappe-Site-Name ${NXERP_SITE};
    proxy_set_header Origin $scheme://$http_host;
    proxy_set_header Host $host;
    proxy_pass http://$nxerp_websocket;
  }

  location / {
    proxy_set_header X-Frappe-Site-Name ${NXERP_SITE};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 120s;
    proxy_redirect off;
    proxy_pass http://$nxerp_backend;
  }
}
