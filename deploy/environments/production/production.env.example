# Template for the PRODUCTION environment. Two destinations, never mix them up:
#   [host]   lines go into /opt/nxerp/.env on the production host (mode 600, owned by the deploy user)
#   [var]    GitHub Environment "production" -> Variables   (not secret)
#   [secret] GitHub Environment "production" -> Secrets     (never in git, never in logs)
# Every value below is a placeholder. Nothing here is a real host, domain, key or password.

# [var] where the deploy workflow connects
DEPLOY_HOST=app.example.test
DEPLOY_USER=deploy
DEPLOY_PATH=/opt/nxerp
PRODUCTION_URL=https://app.example.test
NXERP_SITE=app.example.test
NXERP_IMAGE=ghcr.io/sria-infotech-pvt-ltd/nxerp

# [secret] SSH private key of the deploy user, and the host's public key line for known_hosts
DEPLOY_SSH_KEY=<ssh private key; secret>
DEPLOY_KNOWN_HOSTS=<output of: ssh-keyscan -t ed25519 app.example.test>
# [secret] token that can pull the image from the registry (read:packages)
REGISTRY_PULL_TOKEN=<token; secret>

# [host] application secrets, read by docker compose on the host
NXERP_DB_ROOT_PASSWORD=<generated; secret>
NXERP_ADMIN_PASSWORD=<generated; secret>
NXERP_IMAGE_TAG=<set by the deploy workflow, e.g. 0.1.0-ab12cd34ef56>
NXERP_PUBLIC_URL=https://app.example.test
NXERP_HTTP_PORT=8080

# [host] SMTP (outgoing mail). Frappe reads Email Account records from the database; configure it in the UI after first
# deploy, or script it. These are the values the owner must supply:
SMTP_SERVER=<smtp host>
SMTP_PORT=587
SMTP_USER=<smtp user; secret>
SMTP_PASSWORD=<smtp password; secret>

# [host] off-site backup target used by NXERP_BACKUP_UPLOAD_CMD (owner's choice of storage)
NXERP_BACKUP_DIR=/var/backups/nxerp
NXERP_BACKUP_KEEP_DAYS=30
BACKUP_REMOTE=<e.g. an rclone remote name>
BACKUP_REMOTE_CREDENTIALS=<secret>
